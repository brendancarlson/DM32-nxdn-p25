+uint32_t codeplug_nxdn_id(void)
+{
+	uint8_t b[3];
+	uint32_t id = 0;
+	storage_lock();
+	if (source == CODEPLUG_OPENFW && flash_read(GEN_NXDN_ID, b, sizeof(b)) && b[0] == GEN_NXDN_MARK) {
+		id = ((uint32_t)b[1] << 8) | b[2];
+	}
+	storage_unlock();
+	return id <= CODEPLUG_NXDN_ID_MAX ? id : 0;
