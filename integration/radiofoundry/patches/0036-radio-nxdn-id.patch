+
+bool codeplug_set_nxdn_id(uint32_t id)
+{
+	uint8_t b[3] = { 0xFF, 0xFF, 0xFF };
+	if (id > CODEPLUG_NXDN_ID_MAX) {
+		return false;
+	}
+	if (id != 0) {
+		b[0] = GEN_NXDN_MARK;
+		b[1] = (uint8_t)(id >> 8);
+		b[2] = (uint8_t)id;
+	}
+	storage_lock();
+	bool ok = materialize() && flash_write(GEN_NXDN_ID, b, sizeof(b));
+	if (ok) {
+		serial++;
+	}
+	storage_unlock();
+	return ok;
